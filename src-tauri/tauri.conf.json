{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-credit-manager",
  "version": "0.1.0",
  "identifier": "cn.aicredit.manager",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI路由助手",
        "width": 560,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
