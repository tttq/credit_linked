{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Free Router",
  "version": "0.1.2",
  "identifier": "cn.aicredit.manager",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Free Router",
        "width": 560,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../crates/credit-gateway/sidecar/*"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
